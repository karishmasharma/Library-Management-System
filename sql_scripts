-- Task 13: Identify Members with Overdue Books
Write a query to identify members who have overdue books (assume a 30-day return period). 
Display the member's_id, member's name, book title, issue date, and days overdue.

select 
    m.member_id,
    m.member_name,
    i.issued_date,
    b.book_title,
    datediff(curdate(), i.issued_date) as overdue_date
from members as m
left join issued_status as i 
    on i.issued_member_id = m.member_id
join books as b 
    on b.isbn = i.issued_book_isbn
left join return_status r 
    on r.issued_id = i.issued_id
where r.return_date is null
  and datediff(curdate(), i.issued_date) > 30
order by 1;

-- Task 14: Update Book Status on Return
Write a query to update the status of books in the books table to "Yes" when they are returned (based on entries in the return_status table).

update books b
set b.status =
 case when exists(
 select 1
 from issued_status i
 left join return_status r on r.issued_id=i.issued_id
 where i.issued_book_isbn=b.isbn
 and r.return_date is null
 ) then 'No'
 else 'Yes'
 end;

-- Task 15: Branch Performance Report
Create a query that generates a performance report for each branch, showing the number of books issued, the number of books returned, 
and the total revenue generated from book rentals.


with cte as (
select 
    b.branch_id,i.issued_book_isbn,
    count(i.issued_book_name) as No_of_books_issued,
    count(r.return_id) as no_of_return_books
    from branch b
    left join employees e on e.branch_id = b.branch_id
    left join issued_status i on i.issued_emp_id = e.emp_id
    left join return_status r on r.issued_id = i.issued_id
group by b.branch_id, i.issued_book_isbn, b.manager_id) 

select c.branch_id,c.manager_id sum(c.No_of_books_issued* e.rental_price) as total_revenue, sum(No_of_books_issued) as Total_books,sum(no_of_return_books)as Total_return_books
from cte c
join books e on e.isbn= c.issued_book_isbn
group by c.branch_id,c.manager_id;


